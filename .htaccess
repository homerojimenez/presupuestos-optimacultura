# Presupuestos ÓptimaCultura — enrutado y protección (Apache / SiteGround)

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Imágenes subidas y API pasan por el front controller PHP.
  # (el -f evita bucles: cuando ya se reescribió a api/index.php, no vuelve a entrar)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^uploads/.+$ api/index.php [L,QSA]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^api(/.*)?$ api/index.php [L,QSA]
</IfModule>

# Página por defecto
DirectoryIndex index.html

# Bloquear acceso web directo a datos y configuración.
# OJO: en SiteGround esto NO basta para la carpeta de datos. NGINX sirve los
# estáticos sin consultar Apache, así que un .txt o una imagen bajo el document
# root siguen siendo descargables. La protección de verdad es tener la carpeta
# de datos fuera de public_html (ver 'sqlite_path' en config.php).
RedirectMatch 404 ^/data/
<FilesMatch "^config(\.sample)?\.php$">
  Require all denied
</FilesMatch>
